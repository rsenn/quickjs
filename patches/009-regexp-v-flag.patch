# Fixes the regular expression v flag (unicode sets) in libregexp.c.
#
# get_class_atom() rejected a plain - and the reserved punctuators ( ) [ ] { }
# / | outside a class too, so /a-b/v and /^(?:-?\d+n)/v threw "invalid
# character in class". The same check for doubled punctuators (&& !! ## ...)
# also applied outside a class. Both now need inclass.
#
# Inside a class the v flag allows the escaped class set punctuators
# & ! # % , : ; < = > @ ` ~ (ClassSetReservedPunctuator), which threw "invalid
# escape sequence": /[a\&]/v. Outside the v flag they stay as before.
#
# Test: qjs-modules tests/unittests/test-regexp-v.js.
#
diff --git a/libregexp.c b/libregexp.c
index c387f00..67be9ed 100644
--- a/libregexp.c
+++ b/libregexp.c
@@ -1102,6 +1102,22 @@ static int get_class_atom(REParseState *s, REStringList *cr,
             if (!inclass && s->is_unicode)
                 goto invalid_escape;
             break;
+        case '&':
+        case '!':
+        case '#':
+        case '%':
+        case ',':
+        case ':':
+        case ';':
+        case '<':
+        case '=':
+        case '>':
+        case '@':
+        case '`':
+        case '~':
+            if (s->unicode_sets && inclass)
+                break;
+            goto default_escape;
         case '^':
         case '$':
         case '\\':
@@ -1183,7 +1199,7 @@ static int get_class_atom(REParseState *s, REStringList *cr,
     case '^':
     case '`':
     case '~':
-        if (s->unicode_sets && p[1] == c) {
+        if (s->unicode_sets && inclass && p[1] == c) {
             /* forbidden double characters */
             return re_parse_error(s, "invalid class set operation in regular expression");
         }
@@ -1198,7 +1214,7 @@ static int get_class_atom(REParseState *s, REStringList *cr,
     case '/':
     case '-':
     case '|':
-        if (s->unicode_sets) {
+        if (s->unicode_sets && inclass) {
             /* invalid characters in unicode sets */
             return re_parse_error(s, "invalid character in class in regular expression");
         }
