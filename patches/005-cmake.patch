+  add_unique(MODULE_PATH "${QUICKJS_C_MODULE_DIR}" "${QUICKJS_JS_MODULE_DIR}")
+
+  if(NOT WIN32)
+    string(REPLACE ":" ";" MODULE_PATH "${MODULE_PATH}")
+  endif(NOT WIN32)
+
+  set(QUICKJS_MODULE_PATH
+      "${MODULE_PATH}"
+      CACHE PATH "QuickJS modules search path")
