+  endif(NOT BUILTIN)
+  if(ARGN)
+    set(LIB "${ARGN}")
+  endif(ARGN)
+  if(LIB)
+    check_library_exists("${LIB}" "${NAME}" "" RESULT)
+  else(LIB)
+    check_function_exists(${NAME} RESULT)
+  endif(LIB)
+  set("HAVE_${UNAME}"
+      "${RESULT}"
+      PARENT_SCOPE)
+
+  if(NOT RESULT)
+    check_builtin("${BUILTIN}" B_RESULT)
+    set("HAVE_${BUILTIN}"
+        "${B_RESULT}"
+        PARENT_SCOPE)
+    if(B_RESULT)
+      # add_definitions("-D${NAME}(x...)=${BUILTIN}(x)")
+    endif(B_RESULT)
+  endif(NOT RESULT)
+  if(RESULT)
+    list(APPEND HAVE_VARIABLES HAVE_${UNAME})
+    set(HAVE_VARIABLES
+        "${HAVE_VARIABLES}"
+        PARENT_SCOPE)
+  endif(RESULT)
+endfunction(check_func NAME)
