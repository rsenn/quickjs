+macro(check_builtin NAME VAR)
+  set(RESULT "${${VAR}}")
+  if(RESULT STREQUAL "")
+    set(SOURCE "int main() { void *ptr;  ptr = &${NAME}; return ptr != 0; }")
+    set(C_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/try-${NAME}.c")
+    file(WRITE "${C_SOURCE}" "${SOURCE}")
+    try_compile(
+      RESULT "${CMAKE_CURRENT_BINARY_DIR}"
+      "${C_SOURCE}"
+      OUTPUT_VARIABLE OUTPUT
+      LINK_OPTIONS -c
+      LINK_LIBRARIES "${ARGN}")
+
+    if(NOT RESULT)
+      set(RESULT FALSE)
+    endif(NOT RESULT)
+  endif(RESULT STREQUAL "")
+  if(RESULT)
+    set(MSG found)
+  else(RESULT)
+    set(MSG missing)
+  endif(RESULT)
+  set("${VAR}"
+      "${RESULT}"
+      PARENT_SCOPE)
+
+endmacro(
+  check_builtin
+  NAME
+  VAR)
