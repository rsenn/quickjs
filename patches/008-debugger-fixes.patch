# Fixes two bugs in the embedded debugger of patch 001 (apply after it):
#
# 1. Line breakpoints rarely fired. js_debugger_check_breakpoint() decodes
#    pc2line, whose entries each end in a column delta (sleb128) since the
#    (line, column) format change; the old loop never consumed it, so it
#    desynchronised after the first entry and only the first line of a
#    function could match. It also only marked a line whose successor was a
#    higher line, so a loop body (followed by the `i++` code of the header
#    line) or any line the code returns to was never marked, and it scanned
#    forward once per breakpoint. It now walks the entries once, skips the
#    column delta, and marks every pc segment of every requested line.
#
# 2. `print EXPR` / `evaluate` crashed the debuggee (SIGSEGV).
#    Evaluating an identifier closes over the frame's locals/arguments, but
#    get_var_ref() only has a var_ref slot for variables the compiler marked
#    captured, so it indexed past sf->var_refs. With QUICKJS_DEBUGGER an
#    uncaptured variable now gets a detached copy of its current value, and
#    js_debugger_eval() stores the copies back into the frame afterwards, so
#    `print b=100` still assigns. js_debugger_evaluate() also passes the
#    innermost variable as scope index (its scope_next chain reaches all
#    enclosing scopes) and js_debugger_eval() hands it to
#    add_closure_variables() unchanged, as JS_EvalInternal does.
#
diff --git a/quickjs.c b/quickjs.c
index fd20aee..7a27180 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -17064,6 +17064,17 @@ static JSVarRef *get_var_ref(JSContext *ctx, JSStackFrame *sf, int var_idx,
         vd = &b->vardefs[b->arg_count + var_idx];
         pvalue = &sf->var_buf[var_idx];
     }
+#ifdef QUICKJS_DEBUGGER
+    if (!vd->is_captured) {
+        /* debugger eval of a variable the compiler did not capture: the
+           frame has no var_ref slot for it, so hand out a detached copy;
+           js_debugger_eval() writes changes back */
+        var_ref = js_create_var_ref(ctx, FALSE);
+        if (var_ref)
+            var_ref->value = JS_DupValue(ctx, *pvalue);
+        return var_ref;
+    }
+#endif
     assert(vd->is_captured);
     var_ref_idx = vd->var_ref_idx;
     assert(var_ref_idx < b->var_ref_count);
@@ -61410,9 +61421,21 @@ js_debugger_check_breakpoint(JSContext* ctx, uint32_t current_dirty, const uint8
   JS_FreeValue(ctx, breakpoints_length_property);
 
   const uint8_t *p_end, *p;
-  int new_line_num, line_num, pc, v, ret;
+  int new_line_num, line_num, pc, v, ret, seg_pc, seg_line;
   unsigned int op;
   uint32_t leb_val;
+  uint32_t i, nlines = 0;
+  uint32_t* lines = breakpoints_length ? js_malloc_rt(ctx->rt, sizeof(uint32_t) * breakpoints_length) : NULL;
+
+  // the requested lines, in any order
+  for(i = 0; lines && i < breakpoints_length; i++) {
+    JSValue breakpoint = JS_GetPropertyUint32(ctx, breakpoints, i);
+    JSValue breakpoint_line_prop = JS_GetPropertyStr(ctx, breakpoint, "line");
+    JS_ToUint32(ctx, &lines[nlines], breakpoint_line_prop);
+    nlines++;
+    JS_FreeValue(ctx, breakpoint_line_prop);
+    JS_FreeValue(ctx, breakpoint);
+  }
 
   p = b->debug.pc2line_buf;
   p_end = p + b->debug.pc2line_len;
@@ -61422,82 +61445,74 @@ js_debugger_check_breakpoint(JSContext* ctx, uint32_t current_dirty, const uint8
   // numbers (leb128-encoded); skip the column, we only track lines.
   ret = get_leb128(&leb_val, p, p_end);
   if(ret < 0)
-    goto fail;
+    goto fail_lines;
   p += ret;
   line_num = leb_val + 1;
   ret = get_leb128(&leb_val, p, p_end);
   if(ret < 0)
-    goto fail;
+    goto fail_lines;
   p += ret;
 
-  for(uint32_t i = 0; i < breakpoints_length; i++) {
-    JSValue breakpoint = JS_GetPropertyUint32(ctx, breakpoints, i);
-    JSValue breakpoint_line_prop = JS_GetPropertyStr(ctx, breakpoint, "line");
-    uint32_t breakpoint_line;
-    JS_ToUint32(ctx, &breakpoint_line, breakpoint_line_prop);
-    JS_FreeValue(ctx, breakpoint_line_prop);
-    JS_FreeValue(ctx, breakpoint);
-
-    // breakpoint is before the current line.
-    // todo: this may be an invalid breakpoint if it's inside the function, but got
-    // skipped over.
-    if(breakpoint_line < line_num)
-      continue;
-    // breakpoint is after function end. can stop, as breakpoints are in sorted order.
-    if(b->debugger.last_line_num && breakpoint_line > b->debugger.last_line_num)
-      break;
-
-    int last_line_num = line_num;
-    int line_pc = pc;
+  // pc2line entries say "from this pc on, the code belongs to that line", so
+  // the code of a line is the union of its segments (a loop revisits its
+  // header line after the body); mark every segment of every requested line
+  seg_pc = 0;
+  seg_line = line_num;
 
-    // scan until we find the start pc for the breakpoint
-    while(p < p_end && line_num <= breakpoint_line) {
+  for(;;) {
+    int end_pc;
 
-      // scan line by line
-      while(p < p_end && line_num == last_line_num) {
-        op = *p++;
-        if(op == 0) {
-          uint32_t val;
-          ret = get_leb128(&val, p, p_end);
-          if(ret < 0)
-            goto fail;
-          pc += val;
-          p += ret;
-          ret = get_sleb128(&v, p, p_end);
-          if(ret < 0)
-            goto fail;
-          p += ret;
-          new_line_num = line_num + v;
-        } else {
-          op -= PC2LINE_OP_FIRST;
-          pc += (op / PC2LINE_RANGE);
-          new_line_num = line_num + (op % PC2LINE_RANGE) + PC2LINE_BASE;
-        }
-        line_num = new_line_num;
+    if(p < p_end) {
+      op = *p++;
+      if(op == 0) {
+        uint32_t val;
+        ret = get_leb128(&val, p, p_end);
+        if(ret < 0)
+          goto fail_lines;
+        pc += val;
+        p += ret;
+        ret = get_sleb128(&v, p, p_end);
+        if(ret < 0)
+          goto fail_lines;
+        p += ret;
+        new_line_num = seg_line + v;
+      } else {
+        op -= PC2LINE_OP_FIRST;
+        pc += (op / PC2LINE_RANGE);
+        new_line_num = seg_line + (op % PC2LINE_RANGE) + PC2LINE_BASE;
       }
+      // every entry ends in a column delta; skipping it keeps the decoder in sync
+      ret = get_sleb128(&v, p, p_end);
+      if(ret < 0)
+        goto fail_lines;
+      p += ret;
+      end_pc = pc;
+    } else {
+      end_pc = b->byte_code_len;
+      new_line_num = -1;
+    }
 
-      if(line_num != last_line_num) {
-        // new line found, check if it is the one with breakpoint.
-        if(last_line_num == breakpoint_line && line_num > last_line_num)
-          memset(b->debugger.breakpoints + line_pc, 1, pc - line_pc);
+    if(end_pc > b->byte_code_len)
+      end_pc = b->byte_code_len;
 
-        // update the line trackers
-        line_pc = pc;
-        last_line_num = line_num;
-      }
-    }
+    if(end_pc > seg_pc)
+      for(i = 0; i < nlines; i++)
+        if(lines[i] == (uint32_t)seg_line) {
+          memset(b->debugger.breakpoints + seg_pc, 1, end_pc - seg_pc);
+          break;
+        }
 
-    if(p >= p_end) {
-      b->debugger.last_line_num = line_num;
+    if(new_line_num < 0)
+      break;
 
-      // the breakpoint line is the function's last mapped line (e.g. a
-      // final explicit return): no higher line follows in pc2line, so the
-      // loop above never marked it. mark through the end of the bytecode.
-      if(last_line_num == breakpoint_line && line_pc < b->byte_code_len)
-        memset(b->debugger.breakpoints + line_pc, 1, b->byte_code_len - line_pc);
-    }
+    seg_pc = end_pc;
+    seg_line = new_line_num;
   }
 
+fail_lines:
+  if(lines)
+    js_free_rt(ctx->rt, lines);
+
 fail:
   JS_FreeValue(ctx, breakpoints);
 
@@ -61653,13 +61668,7 @@ js_debugger_eval(JSContext* ctx,
   fd->js_mode = js_mode;
   fd->func_name = JS_DupAtom(ctx, JS_ATOM__eval_);
   if(b) {
-    int idx;
-    if(!b->var_count)
-      idx = -1;
-    else
-      idx =
-          (b->vardefs && b->vardefs[b->arg_count + scope_idx].scope_next != scope_idx) ? 0 : -1;
-    if(add_closure_variables(ctx, fd, b, idx))
+    if(add_closure_variables(ctx, fd, b, scope_idx))
       goto fail;
   }
   fd->module = NULL;
@@ -61683,7 +61692,32 @@ js_debugger_eval(JSContext* ctx,
   if(flags & JS_EVAL_FLAG_COMPILE_ONLY) {
     ret_val = fun_obj;
   } else {
-    ret_val = JS_EvalFunctionInternal(ctx, fun_obj, this_obj, var_refs, sf);
+    JSObject* fp;
+    JSFunctionBytecode* fb;
+    JSValue func;
+
+    func = js_closure(ctx, fun_obj, var_refs, sf, TRUE);
+    if(JS_IsException(func))
+      goto fail1;
+    fp = JS_VALUE_GET_OBJ(func);
+    fb = fp->u.func.function_bytecode;
+    JS_DupValue(ctx, func);
+    ret_val = JS_CallFree(ctx, func, this_obj, 0, NULL);
+
+    // variables without a var_ref slot were evaluated on detached copies:
+    // store the (possibly assigned) values back into the frame
+    for(int i = 0; i < fb->closure_var_count; i++) {
+      JSClosureVar* cv = &fb->closure_var[i];
+      JSVarRef* r = fp->u.func.var_refs[i];
+      JSValue* dst;
+
+      if((cv->closure_type != JS_CLOSURE_LOCAL && cv->closure_type != JS_CLOSURE_ARG) || !r || !r->is_detached || cv->is_const)
+        continue;
+      dst = cv->closure_type == JS_CLOSURE_ARG ? &sf->arg_buf[cv->var_idx] : &sf->var_buf[cv->var_idx];
+      JS_FreeValue(ctx, *dst);
+      *dst = JS_DupValue(ctx, r->value);
+    }
+    JS_FreeValue(ctx, func);
   }
   return ret_val;
 fail1:
@@ -61706,7 +61740,9 @@ js_debugger_evaluate(JSContext* ctx, int stack_index, JSValue expression) {
       return JS_UNDEFINED;
     JSFunctionBytecode* b = f->u.func.function_bytecode;
 
